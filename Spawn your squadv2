local buttonObjects = {}

local function createMenuButton(text, pos, color, stateKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 240, 0, 45)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = MainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    
    buttonObjects[stateKey] = {
        Object = btn,
        DefaultColor = color,
        BaseText = text
    }
    
    btn.MouseButton1Click:Connect(function()
        if activeKey == stateKey then
            activeKey = nil
            btn.Text = text .. ": OFF"
            btn.BackgroundColor3 = color
        else
            for k, data in pairs(buttonObjects) do
                data.Object.Text = data.BaseText .. ": OFF"
                data.Object.BackgroundColor3 = data.DefaultColor
            end
            activeKey = stateKey
            btn.Text = text .. ": ON"
            btn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
        end
    end)
end

