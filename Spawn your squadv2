    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Parent = SpeedFrame
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 5)
    c.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        -- Modify teleport speed bound within 0.01s (insanely fast) and 2.0s (slow)
        _G.TeleportSpeed = math.clamp(_G.TeleportSpeed + delta, 0.01, 2.0)
        SpeedDisplay.Text = string.format("%.2fs", _G.TeleportSpeed)
    end)
end

